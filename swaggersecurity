from sqlalchemy import (
    Column, Integer, String, DateTime, JSON, ForeignKey
)
from sqlalchemy.sql import func
from sqlalchemy.orm import relationship
from database.db import Base


class AuditLog(Base):
    __tablename__ = "audit_logs"

    id = Column(Integer, primary_key=True)

    # Who performed the action (nullable for system events)
    user_id = Column(Integer, ForeignKey("users.id"), index=True, nullable=True)
    user = relationship("User")

    # What entity was affected (report, job, tool, agent, user, file)
    entity = Column(String, nullable=False)

    # Entity ID — e.g. job_id, report_id
    entity_id = Column(Integer, nullable=True)

    # Action performed
    action = Column(String, nullable=False)
    """
    Examples:
    - "create"
    - "update"
    - "delete"
    - "status_change"
    - "tool_execute"
    - "report_generated"
    - "pdf_export"
    - "login"
    """

    # Optional: new/old values
    before = Column(JSON, nullable=True)
    after = Column(JSON, nullable=True)

    # Additional context (IP, errors, tool used, etc.)
    metadata = Column(JSON, nullable=True)

    # Timestamp of log entry
    created_at = Column(DateTime, server_default=func.now())
