from sqlalchemy import (
    Column, Integer, String, DateTime, JSON, Enum, ForeignKey
)
from sqlalchemy.sql import func
from sqlalchemy.orm import relationship
from database.db import Base
import enum


# -----------------------------
# Report Status Enum
# -----------------------------
class ReportStatus(enum.Enum):
    pending = "pending"
    generating = "generating"
    completed = "completed"
    failed = "failed"


# -----------------------------
# Report Model
# -----------------------------
class Report(Base):
    __tablename__ = "reports"

    id = Column(Integer, primary_key=True)

    # Title shown in UI
    title = Column(String, nullable=False)

    # Type of Report: summary, analysis, insights, compliance, etc.
    type = Column(String, nullable=False)

    # pending / generating / completed / failed
    status = Column(Enum(ReportStatus),
                    default=ReportStatus.pending,
                    nullable=False)

    # Final report content (structured JSON)
    content = Column(JSON, nullable=True)

    """
    Example content:
    {
        "executive_summary": "...",
        "findings": [...],
        "risks": [...],
        "citations": [
            {"source": "web", "url": "..."},
            {"source": "document", "page": 14}
        ]
    }
    """

    # If report exported to PDF/DOCX — store file path
    file_url = Column(String, nullable=True)

    # Version tracking (important for editing & audit)
    version = Column(Integer, default=1)

    # Who requested this report
    user_id = Column(Integer, ForeignKey("users.id"), index=True)
    user = relationship("User")

    # Link back to job that generated this report
    job_id = Column(Integer, ForeignKey("jobs.id"), nullable=True)
    job = relationship("Job")

    # Extra JSON metadata (optional)
    metadata = Column(JSON, nullable=True)

    """
    Example metadata:
    {
        "topic": "RFP Analysis",
        "documents_used": [1, 2, 3],
        "duration_sec": 33,
        "agent_version": "v1.3"
    }
    """

    # Timestamps
    created_at = Column(DateTime, server_default=func.now())
    updated_at = Column(DateTime, server_default=func.now(), onupdate=func.now())
    generated_at = Column(DateTime, nullable=True)
